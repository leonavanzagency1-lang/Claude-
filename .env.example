# ───────────────────────────────────────────────────────────────
# Offert från platsbesöket – miljövariabler
# Kopiera till .env:  cp .env.example .env
# Alla nycklar används enbart på serversidan och når aldrig webbläsaren.
# ───────────────────────────────────────────────────────────────

# SQLite-databas (sökvägen är relativ till mappen prisma/)
DATABASE_URL="file:./dev.db"

# Mock-läge: true = ingen AI eller transkribering anropas. En exempeltranskribering
# och ett exempelsvar används i stället, så hela flödet kan testas utan API-nycklar.
MOCK_AI=true

# Anthropic (Claude) – tolkar transkribering, anteckningar och foton till offertrader.
# Nyckel skapas på https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modellnamn. Aktuellt modellnamn (oktober 2026) enligt Anthropics dokumentation:
ANTHROPIC_MODEL=claude-opus-5-5
# Valfritt: hur grundligt modellen ska resonera: low, medium, high, xhigh eller max.
# Tomt = modellens standard. "high" ger bättre tolkning men tar längre tid och kostar mer.
ANTHROPIC_EFFORT=high

# OpenAI – taltranskribering (svenska) via OpenAI:s transkriberings-API.
OPENAI_API_KEY=
# Transkriberingsmodell. Tillgängliga namn enligt OpenAI:s API: gpt-4o-transcribe,
# gpt-4o-mini-transcribe, whisper-1 m.fl.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Mapp för uppladdade filer (ljud, foton, logotyp). Ignoreras av git.
UPLOAD_DIR=./uploads

# Valfritt: tillåt åtkomst till utvecklingsservern från mobilen i samma nätverk.
# Ange datorns IP-adress, t.ex. 192.168.1.20 (kommaseparerat för flera).
DEV_ALLOWED_ORIGINS=
